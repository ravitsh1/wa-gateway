# Listen on localhost only; nginx (or the calling app on the same server) reaches it there.
HOST=127.0.0.1
PORT=3040
# Session keys, SQLite db and temporary media live here. Keep it out of any web root; chmod 700.
DATA_DIR=./data
CLIENTS_FILE=./clients.json
# Public base URL that clients use to fetch media (what nginx exposes, or http://127.0.0.1:3040).
PUBLIC_URL=http://127.0.0.1:3040
# Local numbers starting with 0 are expanded with this country code.
DEFAULT_COUNTRY_CODE=972
# Minimum gap between outgoing messages (ms).
SEND_MIN_INTERVAL_MS=3000
# Undelivered webhooks and downloaded media are deleted after this many hours.
RETENTION_HOURS=72
MAX_MEDIA_MB=50
LOG_LEVEL=info
