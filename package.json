{
  "name": "wa-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted WhatsApp gateway (linked device) with an HTTP API and signed webhooks",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --disable-warning=ExperimentalWarning dist/src/index.js",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.9.0"
  }
}
